{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "infrastructure"
  ],
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "snapshot:fixture": "tsx scripts/build-fixture-snapshot.ts",
    "build:hugo": "tsx scripts/run-hugo.ts",
    "build:site": "npm run snapshot:fixture && npm run build:hugo",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit --project tsconfig.json --pretty false",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
