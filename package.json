{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "infrastructure"
  ],
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "snapshot:fixture": "tsx scripts/build-fixture-snapshot.ts",
    "build:search": "esbuild packages/search/src/main.ts --bundle --format=esm --target=es2024 --minify --outfile=site/assets/js/search.js",
    "build:hugo": "npm run build:search && tsx scripts/run-hugo.ts",
    "index:site": "pagefind --site site/public --output-subdir pagefind",
    "build:site": "npm run snapshot:fixture && npm run build:hugo && npm run index:site",
    "preview": "python3 scripts/serve-site.py",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit --project tsconfig.json --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:site": "npm run build:site && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "pagefind": "^1.5.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
