{{ $publication := hugo.Data.publication }}
{{ if ne (int $publication.schemaVersion) 2 }}
	{{ errorf "Unsupported publication snapshot schema version %v; expected 2" $publication.schemaVersion }}
{{ end }}

{{/* Every post becomes one Hugo page; its kind selects the layout. The home
     post is headless: home.html renders it, so it has no route of its own. */}}
{{ $layouts := dict "home" "home-post" "resume" "resume" "writing" "entry" "project" "entry" }}
{{ range $publication.posts }}
	{{ $dates := dict "lastmod" (time.AsTime .updated) }}
	{{ with .date }}{{ $dates = merge $dates (dict "date" (time.AsTime .)) }}{{ end }}
	{{ $page := dict
		"content" (dict "mediaType" "text/html" "value" .html)
		"dates" $dates
		"kind" "page"
		"params" (dict
			"postKind" .kind
			"sourceId" .sourceId
			"previewText" .previewText
			"tags" .tags
			"pinOrder" .pinOrder
			"asset" .asset
			"contentFingerprint" .contentFingerprint
		)
		"path" .slug
		"title" .title
		"type" (index $layouts .kind)
	}}
	{{ if eq .kind "home" }}
		{{ $page = merge $page (dict "build" (dict "render" "never" "list" "never")) }}
	{{ end }}
	{{ $.AddPage $page }}
{{ end }}

{{ $.AddPage (dict
	"content" (dict "mediaType" "text/html" "value" "")
	"kind" "page"
	"params" (dict "previewText" "Browse every published project and piece of writing.")
	"path" "index"
	"title" "Index"
	"type" "corpus-index"
)
}}
