{
  "files": {
    "includes": [
      "**/*.{js,mjs,cjs,ts,mts,cts,json,jsonc,css}",
      "!**/node_modules",
      "!**/.build",
      "!**/.ftp-deploy-sync-state.json",
      "!**/.next",
      "!**/coverage",
      "!**/dist",
      "!**/playwright-report",
      "!**/site/public",
      "!**/site/assets/js/search.js",
      "!**/test-results"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
